{
  "tests": [
    {
      "name": "ocr_single_pdf",
      "input": {
        "file_url": "https://arxiv.org/pdf/1708.01204.pdf",
        "languages": ["ch_sim", "en"],
        "gpu": true,
        "dpi": 150
      },
      "timeout": 600000
    },
    {
      "name": "ocr_explicit_action",
      "input": {
        "action": "ocr",
        "file_url": "https://arxiv.org/pdf/2107.00100.pdf",
        "languages": ["en"],
        "gpu": true,
        "dpi": 150
      },
      "timeout": 600000
    },
    {
      "name": "detect_orientation",
      "input": {
        "action": "detect_orientation",
        "file_url": "https://arxiv.org/pdf/1708.01204.pdf",
        "dpi": 150
      },
      "timeout": 300000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX A4500",
    "gpuCount": 1,
    "env": [
      {
        "key": "READER_LANGS",
        "value": "th,en"
      }
    ],
    "allowedCudaVersions": [
      "12.7",
      "12.6",
      "12.5",
      "12.4",
      "12.3",
      "12.2",
      "12.1",
      "12.0"
    ]
  }
}